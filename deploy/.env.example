# Copy to .env and adjust. Never commit .env.

# --- required -------------------------------------------------------------------------
POSTGRES_PASSWORD=change-me-to-a-long-random-string
# key that build machines send as BUILD_TELEMETRY_TOKEN
INGEST_API_KEY=change-me-to-another-long-random-string

# --- common ----------------------------------------------------------------------------
# URL developers reach the server at (embedded in the downloadable CMake client)
PUBLIC_URL=http://localhost:8080
HTTP_PORT=8080
# 9.0 = verified default; 10.0 = .NET 10 LTS (recommended for production)
DOTNET_VERSION=9.0
RETENTION_DAYS=180
RETENTION_COMMAND_DAYS=30
STORE_COMMANDS=true
# seed 30 days of synthetic fleet data into an empty database
DEMO_DATA=false

# --- optional: dashboard single sign-on ----------------------------------------------------
AUTH_MODE=None
# AUTH_MODE=Oidc
# OIDC_AUTHORITY=https://login.microsoftonline.com/<tenant>/v2.0
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_REQUIRED_ROLE=build-telemetry-readers

# --- optional: OpenTelemetry ----------------------------------------------------------------
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
