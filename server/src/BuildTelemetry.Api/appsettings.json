{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.Hosting.Diagnostics": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=buildtelemetry;Username=buildtelemetry;Password=buildtelemetry"
  },
  "Telemetry": {
    "PublicUrl": "",
    "TrustAllProxies": false,
    "Ingest": {
      "AllowAnonymous": true,
      "ApiKeys": {},
      "MaxBundleBytes": 134217728,
      "MaxStepsPerBundle": 250000,
      "RateLimitPerMinute": 600,
      "StoreCommands": true
    },
    "Auth": {
      "Mode": "None",
      "Authority": "",
      "ClientId": "",
      "ClientSecret": "",
      "RequiredRole": ""
    },
    "Retention": {
      "Days": 180,
      "CommandDays": 30,
      "Interval": "01:00:00"
    },
    "Demo": {
      "Seed": false,
      "Days": 30
    }
  }
}
