# =============================================================================
#  BuildTelemetry.cmake - plug-and-play build telemetry for CMake builds
#
#  SPDX-License-Identifier: MIT
#  Copyright (c) 2026 Julian Oberhänsli
#  https://github.com/julianoberhaensli/cmake-build-telemetry (full license text: LICENSE)
# =============================================================================
#
#  Collects timing data for every configure / compile / link / custom step
#  through CMake's native instrumentation (cmake-instrumentation(7), CMake 4.3+)
#  and uploads it to a BuildTelemetry server. Single file, no dependencies:
#  the callback and the uploader are this same file executed with `cmake -P`.
#
#  PROJECT MODE (instrument one project):
#      include(cmake/BuildTelemetry.cmake)            # anywhere in CMakeLists.txt
#    or without touching the project:
#      cmake -DCMAKE_PROJECT_TOP_LEVEL_INCLUDES=/path/to/BuildTelemetry.cmake ...
#
#  MACHINE MODE (instrument every CMake >= 4.3 build of the current user):
#      cmake -DBUILD_TELEMETRY_URL=https://telemetry.example.com -P BuildTelemetry.cmake install
#      cmake -P BuildTelemetry.cmake status | test | uninstall
#      cmake -P BuildTelemetry.cmake flush <build-dir>   # upload pending data now
#
#  DISABLE:  -DBUILD_TELEMETRY=OFF   or   env BUILD_TELEMETRY=OFF   or   env DO_NOT_TRACK=1
#
#  Guarantees
#    * Never fails or changes the result of configure or build: unsupported
#      CMake versions / generators turn telemetry off with one status line,
#      every runtime operation is non-fatal, and the callback's exit code is
#      ignored by CMake.
#    * Minimal overhead: with plain `ninja` CMake already runs the callback in
#      a background daemon; with `cmake --build` the synchronous part only
#      hard-links the snippet files and starts a detached uploader.
#    * Offline-safe: bundles are spooled per build tree and retried with
#      exponential back-off; the spool is size- and age-capped.
#
#  Full reference: docs/client.md
# =============================================================================

# Organisations may set a default endpoint here when vendoring the file
# (the server's /api/v1/client/BuildTelemetry.cmake download does this).
set(_BT_DEFAULT_URL "")
set(_BT_CLIENT_VERSION "1.0.1")

if(CMAKE_VERSION VERSION_LESS 3.24)
  if(NOT CMAKE_SCRIPT_MODE_FILE)
    message(STATUS "BuildTelemetry: CMake ${CMAKE_VERSION} has no build instrumentation (needs >= 4.3) - telemetry off")
    # read the settings so -D options do not trigger "unused variable" warnings
    set(_bt_unused "${BUILD_TELEMETRY}${BUILD_TELEMETRY_URL}${BUILD_TELEMETRY_TOKEN}${BUILD_TELEMETRY_DETAIL}${BUILD_TELEMETRY_TAGS}")
  endif()
  return()
endif()

cmake_policy(PUSH)
# Upper bound 4.3 on purpose: CMP0213 (4.4, UTF-8 archive header charset)
# breaks file(ARCHIVE_CREATE FORMAT raw), which we use for gzip.
cmake_policy(VERSION 3.24...4.3)

# -----------------------------------------------------------------------------
#  Small helpers
# -----------------------------------------------------------------------------

# Quote a CMake string as a JSON string literal (empty -> null when NULLABLE).
function(_bt_json_str out value)
  if(ARGV2 STREQUAL "NULLABLE" AND "${value}" STREQUAL "")
    set(${out} "null" PARENT_SCOPE)
    return()
  endif()
  string(REPLACE "\\" "\\\\" value "${value}")
  string(REPLACE "\"" "\\\"" value "${value}")
  string(REPLACE "\n" "\\n" value "${value}")
  string(REPLACE "\r" "\\r" value "${value}")
  string(REPLACE "\t" "\\t" value "${value}")
  set(${out} "\"${value}\"" PARENT_SCOPE)
endfunction()

# Append "key":<raw json> to the JSON object body held in <objvar>.
function(_bt_obj objvar key raw)
  if("${${objvar}}" STREQUAL "")
    set(${objvar} "\"${key}\":${raw}" PARENT_SCOPE)
  else()
    set(${objvar} "${${objvar}},\"${key}\":${raw}" PARENT_SCOPE)
  endif()
endfunction()

# Append "key":"string" (null when empty).
function(_bt_obj_str objvar key value)
  _bt_json_str(q "${value}" NULLABLE)
  _bt_obj(${objvar} "${key}" "${q}")
  set(${objvar} "${${objvar}}" PARENT_SCOPE)
endfunction()

function(_bt_truthy out value)
  string(TOUPPER "${value}" v)
  if(v MATCHES "^(1|ON|YES|TRUE|Y)$")
    set(${out} TRUE PARENT_SCOPE)
  else()
    set(${out} FALSE PARENT_SCOPE)
  endif()
endfunction()

function(_bt_falsy out value)
  string(TOUPPER "${value}" v)
  if(v MATCHES "^(0|OFF|NO|FALSE|N|DISABLE|DISABLED)$")
    set(${out} TRUE PARENT_SCOPE)
  else()
    set(${out} FALSE PARENT_SCOPE)
  endif()
endfunction()

# True when the environment asks to switch telemetry off.
# NB: never name a variable off/on/yes/no/y/n/true/false - if(off) tests the constant.
function(_bt_env_disabled out)
  set(is_disabled FALSE)
  if(DEFINED ENV{BUILD_TELEMETRY})
    _bt_falsy(is_disabled "$ENV{BUILD_TELEMETRY}")
  endif()
  if(NOT is_disabled AND DEFINED ENV{DO_NOT_TRACK})
    _bt_truthy(is_disabled "$ENV{DO_NOT_TRACK}")
  endif()
  set(${out} ${is_disabled} PARENT_SCOPE)
endfunction()

function(_bt_now_iso out)
  string(TIMESTAMP t "%Y-%m-%dT%H:%M:%SZ" UTC)
  set(${out} "${t}" PARENT_SCOPE)
endfunction()

function(_bt_now_epoch out)
  string(TIMESTAMP t "%s" UTC)
  set(${out} "${t}" PARENT_SCOPE)
endfunction()

# User-wide CMake configuration directory (see CMAKE_CONFIG_DIR, CMake 3.31+).
function(_bt_user_config_dir out)
  if(DEFINED ENV{CMAKE_CONFIG_DIR} AND NOT "$ENV{CMAKE_CONFIG_DIR}" STREQUAL "")
    file(TO_CMAKE_PATH "$ENV{CMAKE_CONFIG_DIR}" d)
  elseif(CMAKE_HOST_WIN32)
    file(TO_CMAKE_PATH "$ENV{LOCALAPPDATA}/CMake" d)
  elseif(CMAKE_HOST_APPLE)
    if(DEFINED ENV{XDG_CONFIG_HOME} AND NOT "$ENV{XDG_CONFIG_HOME}" STREQUAL "")
      set(d "$ENV{XDG_CONFIG_HOME}/CMake")
    else()
      set(d "$ENV{HOME}/Library/Application Support/CMake")
    endif()
  else()
    if(DEFINED ENV{XDG_CONFIG_HOME} AND NOT "$ENV{XDG_CONFIG_HOME}" STREQUAL "")
      set(d "$ENV{XDG_CONFIG_HOME}/cmake")
    else()
      set(d "$ENV{HOME}/.config/cmake")
    endif()
  endif()
  set(${out} "${d}" PARENT_SCOPE)
endfunction()

# Read a key=value settings file into <prefix>_<key> variables (never fatal).
function(_bt_read_settings file prefix)
  if(NOT EXISTS "${file}" OR IS_DIRECTORY "${file}")
    return()
  endif()
  file(STRINGS "${file}" lines REGEX "^[a-z_]+=")
  foreach(line IN LISTS lines)
    string(FIND "${line}" "=" eq)
    string(SUBSTRING "${line}" 0 ${eq} key)
    math(EXPR start "${eq} + 1")
    string(SUBSTRING "${line}" ${start} -1 value)
    set(${prefix}_${key} "${value}" PARENT_SCOPE)
  endforeach()
endfunction()

# Resolve the effective value of one setting:
#   environment variable > CMake variable (project mode) > settings file > default
function(_bt_setting out envname settingsvalue default)
  if(DEFINED ENV{${envname}} AND NOT "$ENV{${envname}}" STREQUAL "")
    set(${out} "$ENV{${envname}}" PARENT_SCOPE)
  elseif(NOT "${settingsvalue}" STREQUAL "")
    set(${out} "${settingsvalue}" PARENT_SCOPE)
  else()
    set(${out} "${default}" PARENT_SCOPE)
  endif()
endfunction()

# Load all runtime settings (callback / worker / management commands).
macro(_bt_load_runtime_settings settings_file)
  set(_bts_url "")
  set(_bts_token "")
  set(_bts_detail "")
  set(_bts_tags "")
  set(_bts_upload "")
  set(_bts_timeout "")
  set(_bts_tls_verify "")
  set(_bts_ca_file "")
  set(_bts_user_id "")
  set(_bts_anonymize "")
  set(_bts_max_spool "")
  set(_bts_mode "")
  _bt_read_settings("${settings_file}" _bts)
  _bt_setting(BT_URL        BUILD_TELEMETRY_URL        "${_bts_url}"        "${_BT_DEFAULT_URL}")
  _bt_setting(BT_TOKEN      BUILD_TELEMETRY_TOKEN      "${_bts_token}"      "")
  _bt_setting(BT_DETAIL     BUILD_TELEMETRY_DETAIL     "${_bts_detail}"     "full")
  _bt_setting(BT_TAGS       BUILD_TELEMETRY_TAGS       "${_bts_tags}"       "")
  _bt_setting(BT_UPLOAD     BUILD_TELEMETRY_UPLOAD     "${_bts_upload}"     "auto")
  _bt_setting(BT_TIMEOUT    BUILD_TELEMETRY_TIMEOUT    "${_bts_timeout}"    "10")
  _bt_setting(BT_TLS_VERIFY BUILD_TELEMETRY_TLS_VERIFY "${_bts_tls_verify}" "ON")
  _bt_setting(BT_CA_FILE    BUILD_TELEMETRY_CA_FILE    "${_bts_ca_file}"    "")
  _bt_setting(BT_USER_ID    BUILD_TELEMETRY_USER_ID    "${_bts_user_id}"    "hash")
  _bt_setting(BT_ANONYMIZE  BUILD_TELEMETRY_ANONYMIZE  "${_bts_anonymize}"  "OFF")
  _bt_setting(BT_MAX_SPOOL  BUILD_TELEMETRY_MAX_SPOOL  "${_bts_max_spool}"  "50")
  set(BT_MODE_KIND "${_bts_mode}")
  string(REGEX REPLACE "/+$" "" BT_URL "${BT_URL}")
  if(NOT BT_TIMEOUT MATCHES "^[0-9]+$")
    set(BT_TIMEOUT 10)
  endif()
  if(NOT BT_MAX_SPOOL MATCHES "^[0-9]+$")
    set(BT_MAX_SPOOL 50)
  endif()
  string(TOLOWER "${BT_DETAIL}" BT_DETAIL)
  if(NOT BT_DETAIL MATCHES "^(full|nocommands|summary)$")
    set(BT_DETAIL full)
  endif()
  _bt_truthy(BT_ANONYMIZE "${BT_ANONYMIZE}")
  if(BT_ANONYMIZE AND BT_DETAIL STREQUAL "full")
    set(BT_DETAIL nocommands)
  endif()
endmacro()

function(_bt_log state_dir msg)
  if(NOT IS_DIRECTORY "${state_dir}")
    return()
  endif()
  set(log "${state_dir}/telemetry.log")
  if(EXISTS "${log}")
    file(SIZE "${log}" sz)
    if(sz GREATER 524288)
      file(RENAME "${log}" "${log}.1" RESULT ignored)
    endif()
  endif()
  _bt_now_iso(t)
  file(APPEND "${log}" "${t} [${CMAKE_VERSION}] ${msg}\n")
endfunction()

