function(_bt_detect_ci)
  set(ci_provider "")
  set(ci_url "")
  set(ci_job "")
  set(ci_runner "")
  set(ci_branch "")
  set(ci_commit "")
  if("$ENV{GITHUB_ACTIONS}" STREQUAL "true")
    set(ci_provider github)
    set(ci_url "$ENV{GITHUB_SERVER_URL}/$ENV{GITHUB_REPOSITORY}/actions/runs/$ENV{GITHUB_RUN_ID}")
    set(ci_job "$ENV{GITHUB_WORKFLOW}/$ENV{GITHUB_JOB}")
    set(ci_runner "$ENV{RUNNER_NAME}")
    if(NOT "$ENV{GITHUB_HEAD_REF}" STREQUAL "")
      set(ci_branch "$ENV{GITHUB_HEAD_REF}")
    else()
      set(ci_branch "$ENV{GITHUB_REF_NAME}")
    endif()
    set(ci_commit "$ENV{GITHUB_SHA}")
  elseif("$ENV{GITLAB_CI}" STREQUAL "true")
    set(ci_provider gitlab)
    set(ci_url "$ENV{CI_JOB_URL}")
    set(ci_job "$ENV{CI_PROJECT_PATH}/$ENV{CI_JOB_NAME}")
    set(ci_runner "$ENV{CI_RUNNER_DESCRIPTION}")
    set(ci_branch "$ENV{CI_COMMIT_REF_NAME}")
    set(ci_commit "$ENV{CI_COMMIT_SHA}")
  elseif(DEFINED ENV{TF_BUILD})
    set(ci_provider azure)
    set(ci_url "$ENV{SYSTEM_COLLECTIONURI}$ENV{SYSTEM_TEAMPROJECT}/_build/results?buildId=$ENV{BUILD_BUILDID}")
    set(ci_job "$ENV{BUILD_DEFINITIONNAME}/$ENV{SYSTEM_JOBDISPLAYNAME}")
    set(ci_runner "$ENV{AGENT_NAME}")
    set(ci_branch "$ENV{BUILD_SOURCEBRANCHNAME}")
    set(ci_commit "$ENV{BUILD_SOURCEVERSION}")
  elseif(DEFINED ENV{JENKINS_URL})
    set(ci_provider jenkins)
    set(ci_url "$ENV{BUILD_URL}")
    set(ci_job "$ENV{JOB_NAME}")
    set(ci_runner "$ENV{NODE_NAME}")
    set(ci_branch "$ENV{GIT_BRANCH}")
    set(ci_commit "$ENV{GIT_COMMIT}")
  elseif("$ENV{BUILDKITE}" STREQUAL "true")
    set(ci_provider buildkite)
    set(ci_url "$ENV{BUILDKITE_BUILD_URL}")
    set(ci_job "$ENV{BUILDKITE_PIPELINE_SLUG}/$ENV{BUILDKITE_LABEL}")
    set(ci_runner "$ENV{BUILDKITE_AGENT_NAME}")
    set(ci_branch "$ENV{BUILDKITE_BRANCH}")
    set(ci_commit "$ENV{BUILDKITE_COMMIT}")
  elseif(DEFINED ENV{TEAMCITY_VERSION})
    set(ci_provider teamcity)
    set(ci_job "$ENV{TEAMCITY_BUILDCONF_NAME}")
    set(ci_runner "$ENV{AGENT_NAME}")
  elseif("$ENV{CIRCLECI}" STREQUAL "true")
    set(ci_provider circleci)
    set(ci_url "$ENV{CIRCLE_BUILD_URL}")
    set(ci_job "$ENV{CIRCLE_JOB}")
    set(ci_branch "$ENV{CIRCLE_BRANCH}")
    set(ci_commit "$ENV{CIRCLE_SHA1}")
  elseif(DEFINED ENV{BITBUCKET_BUILD_NUMBER})
    set(ci_provider bitbucket)
    set(ci_job "$ENV{BITBUCKET_REPO_FULL_NAME}/$ENV{BITBUCKET_BUILD_NUMBER}")
    set(ci_branch "$ENV{BITBUCKET_BRANCH}")
    set(ci_commit "$ENV{BITBUCKET_COMMIT}")
  else()
    _bt_truthy(generic "$ENV{CI}")
    if(generic)
      set(ci_provider generic)
    endif()
  endif()
  foreach(v ci_provider ci_url ci_job ci_runner ci_branch ci_commit)
    set(${v} "${${v}}" PARENT_SCOPE)
  endforeach()
endfunction()

# Branch / commit by reading .git directly (no git process).
function(_bt_git_info src_dir)
  set(git_branch "")
  set(git_commit "")
  set(dir "${src_dir}")
  set(gitdir "")
  foreach(i RANGE 12)
    if(IS_DIRECTORY "${dir}/.git")
      set(gitdir "${dir}/.git")
      break()
    elseif(EXISTS "${dir}/.git")
      file(STRINGS "${dir}/.git" l LIMIT_COUNT 1 REGEX "^gitdir: ")
      string(REGEX REPLACE "^gitdir: *" "" g "${l}")
      if(NOT IS_ABSOLUTE "${g}")
        set(g "${dir}/${g}")
      endif()
      set(gitdir "${g}")
      break()
    endif()
    get_filename_component(parent "${dir}" DIRECTORY)
    if(parent STREQUAL dir OR parent STREQUAL "")
      break()
    endif()
    set(dir "${parent}")
  endforeach()
  if(gitdir STREQUAL "" OR NOT EXISTS "${gitdir}/HEAD")
    set(git_branch "" PARENT_SCOPE)
    set(git_commit "" PARENT_SCOPE)
    return()
  endif()
  set(common "${gitdir}")
  if(EXISTS "${gitdir}/commondir")
    file(STRINGS "${gitdir}/commondir" c LIMIT_COUNT 1)
    if(IS_ABSOLUTE "${c}")
      set(common "${c}")
    else()
      set(common "${gitdir}/${c}")
    endif()
  endif()
  file(STRINGS "${gitdir}/HEAD" head LIMIT_COUNT 1)
  if(head MATCHES "^ref: (.+)$")
    set(ref "${CMAKE_MATCH_1}")
    string(REGEX REPLACE "^refs/heads/" "" git_branch "${ref}")
    foreach(base "${gitdir}" "${common}")
      if(EXISTS "${base}/${ref}")
        file(STRINGS "${base}/${ref}" git_commit LIMIT_COUNT 1)
        break()
      endif()
    endforeach()
    if(git_commit STREQUAL "" AND EXISTS "${common}/packed-refs")
      file(STRINGS "${common}/packed-refs" packed REGEX " ${ref}$")
      if(packed MATCHES "^([0-9a-f]+) ")
        set(git_commit "${CMAKE_MATCH_1}")
      endif()
    endif()
  elseif(head MATCHES "^[0-9a-f]+$")
    set(git_commit "${head}")
  endif()
  set(git_branch "${git_branch}" PARENT_SCOPE)
  set(git_commit "${git_commit}" PARENT_SCOPE)
endfunction()

# CPU model + OS pretty name (CMake's own processorName is unreliable on new CPUs).
function(_bt_host_details)
  set(cpu "")
  set(os "")
  if(CMAKE_HOST_WIN32)
    cmake_host_system_information(RESULT cpu QUERY WINDOWS_REGISTRY
      "HKLM/HARDWARE/DESCRIPTION/System/CentralProcessor/0" VALUE ProcessorNameString)
    cmake_host_system_information(RESULT pn QUERY WINDOWS_REGISTRY
      "HKLM/SOFTWARE/Microsoft/Windows NT/CurrentVersion" VALUE ProductName)
    cmake_host_system_information(RESULT dv QUERY WINDOWS_REGISTRY
      "HKLM/SOFTWARE/Microsoft/Windows NT/CurrentVersion" VALUE DisplayVersion)
    cmake_host_system_information(RESULT cb QUERY WINDOWS_REGISTRY
      "HKLM/SOFTWARE/Microsoft/Windows NT/CurrentVersion" VALUE CurrentBuild)
    if(cb MATCHES "^[0-9]+$" AND cb GREATER_EQUAL 22000)
      string(REPLACE "Windows 10" "Windows 11" pn "${pn}")
    endif()
    string(STRIP "${pn} ${dv}" os)
  elseif(CMAKE_HOST_APPLE)
    execute_process(COMMAND sysctl -n machdep.cpu.brand_string
      OUTPUT_VARIABLE cpu ERROR_QUIET OUTPUT_STRIP_TRAILING_WHITESPACE TIMEOUT 2 RESULT_VARIABLE r)
    execute_process(COMMAND sw_vers -productVersion
      OUTPUT_VARIABLE v ERROR_QUIET OUTPUT_STRIP_TRAILING_WHITESPACE TIMEOUT 2 RESULT_VARIABLE r)
    if(NOT v STREQUAL "")
      set(os "macOS ${v}")
    endif()
  else()
    if(EXISTS "/proc/cpuinfo")
      file(STRINGS "/proc/cpuinfo" m LIMIT_COUNT 1 REGEX "^model name")
      string(REGEX REPLACE "^model name[ \t]*:[ \t]*" "" cpu "${m}")
    endif()
    cmake_host_system_information(RESULT os QUERY DISTRIB_PRETTY_NAME)
  endif()
  string(STRIP "${cpu}" cpu)
  string(REGEX REPLACE "  +" " " cpu "${cpu}")
  set(host_cpu "${cpu}" PARENT_SCOPE)
  set(host_os "${os}" PARENT_SCOPE)
endfunction()

# Stable random machine id persisted in the user config dir.
function(_bt_machine_id out)
  if(DEFINED ENV{BUILD_TELEMETRY_MACHINE_ID} AND NOT "$ENV{BUILD_TELEMETRY_MACHINE_ID}" STREQUAL "")
    set(${out} "$ENV{BUILD_TELEMETRY_MACHINE_ID}" PARENT_SCOPE)
    return()
  endif()
  _bt_user_config_dir(cfg)
  set(f "${cfg}/build-telemetry/machine-id")
  set(id "")
  if(EXISTS "${f}")
    file(STRINGS "${f}" id LIMIT_COUNT 1 REGEX "^[0-9a-f]+$")
  endif()
  if(id STREQUAL "")
    string(RANDOM LENGTH 32 ALPHABET "0123456789abcdef" id)
    file(MAKE_DIRECTORY "${cfg}/build-telemetry" RESULT r)
    if(r EQUAL 0)
      file(WRITE "${f}.tmp" "${id}\n")
      file(RENAME "${f}.tmp" "${f}" RESULT r NO_REPLACE)
      if(NOT r EQUAL 0)
        file(REMOVE "${f}.tmp")
        file(STRINGS "${f}" id LIMIT_COUNT 1 REGEX "^[0-9a-f]+$")
      endif()
    endif()
  endif()
  set(${out} "${id}" PARENT_SCOPE)
endfunction()

# Selected CMakeCache.txt entries -> cache_<NAME> variables in caller scope.
function(_bt_read_cache build_dir)
  set(keys CMAKE_BUILD_TYPE CMAKE_CONFIGURATION_TYPES CMAKE_GENERATOR CMAKE_MAKE_PROGRAM
    CMAKE_PROJECT_NAME CMAKE_HOME_DIRECTORY CMAKE_CXX_COMPILER CMAKE_C_COMPILER
    CMAKE_CXX_COMPILER_LAUNCHER CMAKE_C_COMPILER_LAUNCHER CMAKE_LINKER_TYPE CMAKE_LINKER
    CMAKE_TOOLCHAIN_FILE CMAKE_UNITY_BUILD CMAKE_CACHE_MAJOR_VERSION CMAKE_CACHE_MINOR_VERSION
    CMAKE_CACHE_PATCH_VERSION CMAKE_INTERPROCEDURAL_OPTIMIZATION CMAKE_SYSTEM_NAME)
  foreach(k IN LISTS keys)
    set(cache_${k} "" PARENT_SCOPE)
  endforeach()
  if(NOT EXISTS "${build_dir}/CMakeCache.txt")
    return()
  endif()
  list(JOIN keys "|" alt)
  file(STRINGS "${build_dir}/CMakeCache.txt" lines REGEX "^(${alt}):[A-Z]+=")
  foreach(line IN LISTS lines)
    if(line MATCHES "^([A-Z_]+):[A-Z]+=(.*)$")
      set(cache_${CMAKE_MATCH_1} "${CMAKE_MATCH_2}" PARENT_SCOPE)
    endif()
  endforeach()
endfunction()

# Compiler id/version for one language from CMakeFiles/<ver>/CMake<LANG>Compiler.cmake.
function(_bt_compiler_info build_dir lang cmake_ver out)
  set(${out} "null" PARENT_SCOPE)
  set(f "${build_dir}/CMakeFiles/${cmake_ver}/CMake${lang}Compiler.cmake")
  if(NOT EXISTS "${f}")
    file(GLOB files "${build_dir}/CMakeFiles/*/CMake${lang}Compiler.cmake")
    if(NOT files)
      return()
    endif()
    list(SORT files COMPARE NATURAL ORDER DESCENDING)
    list(GET files 0 f)
  endif()
  file(STRINGS "${f}" lines REGEX "^set\\(CMAKE_${lang}_(COMPILER|COMPILER_ID|COMPILER_VERSION|COMPILER_LINKER_ID|COMPILER_LINKER_VERSION|COMPILER_FRONTEND_VARIANT|COMPILER_ARCHITECTURE_ID) ")
  set(path "")
  set(id "")
  set(ver "")
  set(lid "")
  set(lver "")
  set(variant "")
  set(arch "")
  foreach(l IN LISTS lines)
    if(l MATCHES "^set\\(CMAKE_${lang}_([A-Z_]+) \"([^\"]*)\"\\)")
      set(k "${CMAKE_MATCH_1}")
      set(v "${CMAKE_MATCH_2}")
      if(k STREQUAL "COMPILER")
        set(path "${v}")
      elseif(k STREQUAL "COMPILER_ID")
        set(id "${v}")
      elseif(k STREQUAL "COMPILER_VERSION")
        set(ver "${v}")
      elseif(k STREQUAL "COMPILER_LINKER_ID")
        set(lid "${v}")
      elseif(k STREQUAL "COMPILER_LINKER_VERSION")
        set(lver "${v}")
      elseif(k STREQUAL "COMPILER_FRONTEND_VARIANT")
        set(variant "${v}")
      elseif(k STREQUAL "COMPILER_ARCHITECTURE_ID")
        set(arch "${v}")
      endif()
    endif()
  endforeach()
  if(id STREQUAL "" AND path STREQUAL "")
    return()
  endif()
  set(o "")
  _bt_obj_str(o id "${id}")
  _bt_obj_str(o version "${ver}")
  _bt_obj_str(o frontendVariant "${variant}")
  _bt_obj_str(o architecture "${arch}")
  _bt_obj_str(o linkerId "${lid}")
  _bt_obj_str(o linkerVersion "${lver}")
  get_filename_component(exe "${path}" NAME)
  _bt_obj_str(o executable "${exe}")
  set(${out} "{${o}}" PARENT_SCOPE)
endfunction()

function(_bt_hash_short out value)
  string(SHA256 h "build-telemetry:${value}")
  string(SUBSTRING "${h}" 0 16 h)
  set(${out} "${h}" PARENT_SCOPE)
endfunction()

# -----------------------------------------------------------------------------
#  Bundle creation
# -----------------------------------------------------------------------------

# Snippet file names listed in an index (regex: O(n), never fatal).
function(_bt_index_snippets out idx)
  string(REGEX MATCHALL "\"[A-Za-z]+-[0-9a-f]+-[0-9]+-[0-9]+-[0-9]+T[0-9-]+\\.json\"" names "${idx}")
  string(REPLACE "\"" "" names "${names}")
  if(NOT names)
    # Fallback for unexpected naming: walk the JSON array (fine for small indexes).
    string(JSON n ERROR_VARIABLE err LENGTH "${idx}" snippets)
    if(err STREQUAL "NOTFOUND" AND n MATCHES "^[0-9]+$" AND n GREATER 0 AND n LESS_EQUAL 4000)
      math(EXPR last "${n} - 1")
      foreach(i RANGE ${last})
        string(JSON s ERROR_VARIABLE err GET "${idx}" snippets ${i})
        if(err STREQUAL "NOTFOUND")
          list(APPEND names "${s}")
        endif()
      endforeach()
    endif()
  endif()
  set(${out} "${names}" PARENT_SCOPE)
endfunction()

function(_bt_bundle_id out build_dir index_file)
  get_filename_component(n "${index_file}" NAME)
  string(SHA256 h "${build_dir}|${n}")
  string(SUBSTRING "${h}" 0 8 a)
  string(SUBSTRING "${h}" 8 4 b)
  string(SUBSTRING "${h}" 12 4 c)
  string(SUBSTRING "${h}" 16 4 d)
  string(SUBSTRING "${h}" 20 12 e)
  set(${out} "${a}-${b}-${c}-${d}-${e}" PARENT_SCOPE)
endfunction()

# Build <out_base>.json.gz (or <out_base>.json if compression is unavailable)
# from an index plus the snippet/content files under <files_dir>.
function(_bt_build_bundle idx_text files_dir build_dir bundle_id out_base)
  _bt_index_snippets(names "${idx_text}")
  string(JSON hook ERROR_VARIABLE e1 GET "${idx_text}" hook)
  if(NOT e1 STREQUAL "NOTFOUND")
    set(hook "")
  endif()
  string(JSON vmaj ERROR_VARIABLE e2 GET "${idx_text}" version major)
  string(JSON vmin ERROR_VARIABLE e3 GET "${idx_text}" version minor)
  if(NOT e2 STREQUAL "NOTFOUND")
    set(vmaj 1)
  endif()
  if(NOT e3 STREQUAL "NOTFOUND")
    set(vmin 0)
  endif()
  string(JSON sysinfo ERROR_VARIABLE e4 GET "${idx_text}" staticSystemInformation)
  if(NOT e4 STREQUAL "NOTFOUND")
    set(sysinfo "null")
  endif()

  _bt_read_cache("${build_dir}")
  set(src_dir "${cache_CMAKE_HOME_DIRECTORY}")
  _bt_detect_ci()
  _bt_git_info("${src_dir}")
  if(NOT ci_branch STREQUAL "")
    set(git_branch "${ci_branch}")
  endif()
  if(NOT ci_commit STREQUAL "")
    set(git_commit "${ci_commit}")
  endif()
  _bt_host_details()
  _bt_machine_id(machine_id)

  # --- identity / privacy ---------------------------------------------------
  set(hostname "")
  if(NOT sysinfo STREQUAL "null")
    string(JSON hostname ERROR_VARIABLE e5 GET "${sysinfo}" hostname)
    if(NOT e5 STREQUAL "NOTFOUND")
      set(hostname "")
    endif()
  endif()
  if(hostname STREQUAL "")
    cmake_host_system_information(RESULT hostname QUERY HOSTNAME)
  endif()
  set(user "$ENV{USER}")
  if(user STREQUAL "")
    set(user "$ENV{USERNAME}")
  endif()
  string(TOLOWER "${BT_USER_ID}" uid_mode)
  if(uid_mode STREQUAL "plain")
    set(user_id "${user}")
  elseif(uid_mode STREQUAL "none" OR user STREQUAL "")
    set(user_id "")
  else()
    _bt_hash_short(user_id "user:${user}")
  endif()
  set(rel_src "${src_dir}")
  set(rel_bld "${build_dir}")
  if(BT_ANONYMIZE)
    _bt_hash_short(hostname "host:${hostname}")
    if(NOT sysinfo STREQUAL "null")
      _bt_json_str(qh "${hostname}")
      string(JSON sysinfo ERROR_VARIABLE e6 SET "${sysinfo}" hostname "${qh}")
    endif()
    set(rel_src "$SRC")
    set(rel_bld "$BUILD")
  endif()

  # --- header ----------------------------------------------------------------
  set(client_anon false)
  if(BT_ANONYMIZE)
    set(client_anon true)
  endif()
  set(client "")
  _bt_obj_str(client name "BuildTelemetry.cmake")
  _bt_obj_str(client version "${_BT_CLIENT_VERSION}")
  _bt_obj_str(client mode "${BT_MODE_KIND}")
  _bt_obj_str(client detail "${BT_DETAIL}")
  _bt_obj(client anonymized ${client_anon})

  set(machine "")
  _bt_obj_str(machine id "${machine_id}")
  _bt_obj_str(machine hostname "${hostname}")
  _bt_obj_str(machine user "${user_id}")
  _bt_obj_str(machine cpuModel "${host_cpu}")
  _bt_obj_str(machine osPrettyName "${host_os}")

  set(project "")
  _bt_obj_str(project name "${cache_CMAKE_PROJECT_NAME}")
  _bt_obj_str(project sourceDir "${rel_src}")
  _bt_obj_str(project buildDir "${rel_bld}")

  set(cfg_ver "${cache_CMAKE_CACHE_MAJOR_VERSION}.${cache_CMAKE_CACHE_MINOR_VERSION}.${cache_CMAKE_CACHE_PATCH_VERSION}")
  _bt_compiler_info("${build_dir}" CXX "${cfg_ver}" cxx_info)
  _bt_compiler_info("${build_dir}" C "${cfg_ver}" c_info)
  set(compilers "")
  _bt_obj(compilers CXX "${cxx_info}")
  _bt_obj(compilers C "${c_info}")
  set(launcher "${cache_CMAKE_CXX_COMPILER_LAUNCHER}")
  if(launcher STREQUAL "")
    set(launcher "${cache_CMAKE_C_COMPILER_LAUNCHER}")
  endif()
  if(NOT launcher STREQUAL "")
    list(GET launcher 0 launcher)
    get_filename_component(launcher "${launcher}" NAME_WE)
  endif()
  set(ninja_version "")
  if(cache_CMAKE_GENERATOR MATCHES "Ninja" AND EXISTS "${cache_CMAKE_MAKE_PROGRAM}")
    execute_process(COMMAND "${cache_CMAKE_MAKE_PROGRAM}" --version OUTPUT_VARIABLE ninja_version
      ERROR_QUIET OUTPUT_STRIP_TRAILING_WHITESPACE TIMEOUT 3 RESULT_VARIABLE r)
    if(NOT r EQUAL 0)
      set(ninja_version "")
    endif()
  endif()
  get_filename_component(toolchain "${cache_CMAKE_TOOLCHAIN_FILE}" NAME)
  set(build "")
  _bt_obj_str(build generator "${cache_CMAKE_GENERATOR}")
  _bt_obj_str(build buildTool "${ninja_version}")
  _bt_obj_str(build buildType "${cache_CMAKE_BUILD_TYPE}")
  _bt_obj_str(build configurationTypes "${cache_CMAKE_CONFIGURATION_TYPES}")
  _bt_obj_str(build cmakeVersion "${CMAKE_VERSION}")
  _bt_obj_str(build compilerLauncher "${launcher}")
  _bt_obj_str(build linkerType "${cache_CMAKE_LINKER_TYPE}")
  _bt_obj_str(build toolchainFile "${toolchain}")
  _bt_obj_str(build unityBuild "${cache_CMAKE_UNITY_BUILD}")
  _bt_obj_str(build ipo "${cache_CMAKE_INTERPROCEDURAL_OPTIMIZATION}")
  _bt_obj(build compilers "{${compilers}}")

  set(vcs "")
  _bt_obj_str(vcs branch "${git_branch}")
  _bt_obj_str(vcs commit "${git_commit}")

  set(ci "")
  if(ci_provider STREQUAL "")
    _bt_obj(ci isCI false)
  else()
    _bt_obj(ci isCI true)
  endif()
  _bt_obj_str(ci provider "${ci_provider}")
  _bt_obj_str(ci url "${ci_url}")
  _bt_obj_str(ci job "${ci_job}")
  _bt_obj_str(ci runner "${ci_runner}")

  set(tags "")
  string(REPLACE "," ";" tag_list "${BT_TAGS}")
  foreach(t IN LISTS tag_list)
    if(t MATCHES "^[ ]*([^=]+)=(.*)$")
      string(STRIP "${CMAKE_MATCH_1}" tk)
      string(STRIP "${CMAKE_MATCH_2}" tv)
      _bt_json_str(tkq "${tk}")
      _bt_json_str(tvq "${tv}")
      if(tags STREQUAL "")
        set(tags "${tkq}:${tvq}")
      else()
        string(APPEND tags ",${tkq}:${tvq}")
      endif()
    endif()
  endforeach()

  _bt_now_iso(created)
  set(head "")
  _bt_obj_str(head schema "build-telemetry/bundle@1")
  _bt_obj_str(head bundleId "${bundle_id}")
  _bt_obj_str(head createdAt "${created}")
  _bt_obj_str(head hook "${hook}")
  _bt_obj(head dataVersion "{\"major\":${vmaj},\"minor\":${vmin}}")
  _bt_obj(head client "{${client}}")
  _bt_obj(head machine "{${machine}}")
  _bt_obj(head system "${sysinfo}")
  _bt_obj(head project "{${project}}")
  _bt_obj(head build "{${build}}")
  _bt_obj(head vcs "{${vcs}}")
  _bt_obj(head ci "{${ci}}")
  _bt_obj(head tags "{${tags}}")

  # --- snippets (streamed in chunks; string(APPEND) on one huge string is O(n^2))
  set(out_json "${out_base}.partial")
  file(WRITE "${out_json}" "{${head},\"snippets\":[")
  set(buf "")
  set(sep "")
  set(chunk 0)
  set(stats_roles "")
  foreach(name IN LISTS names)
    set(f "${files_dir}/${name}")
    if(NOT EXISTS "${f}")
      continue()
    endif()
    string(REGEX MATCH "^[A-Za-z]+" role "${name}")
    if(BT_DETAIL STREQUAL "summary" AND role MATCHES "^(compile|link|custom|test|install)$")
      # aggregate per role instead of shipping individual steps
      file(READ "${f}" c)
      set(d 0)
      set(failed 0)
      if(c MATCHES "\"duration\"[ \t\r\n]*:[ \t\r\n]*([0-9]+)")
        set(d "${CMAKE_MATCH_1}")
      endif()
      if(c MATCHES "\"result\"[ \t\r\n]*:[ \t\r\n]*(-?[1-9][0-9]*)")
        set(failed 1)
      endif()
      if(NOT role IN_LIST stats_roles)
        list(APPEND stats_roles ${role})
        set(st_${role}_n 0)
        set(st_${role}_ms 0)
        set(st_${role}_fail 0)
      endif()
      math(EXPR st_${role}_n "${st_${role}_n} + 1")
      math(EXPR st_${role}_ms "${st_${role}_ms} + ${d}")
      math(EXPR st_${role}_fail "${st_${role}_fail} + ${failed}")
      continue()
    endif()
    file(READ "${f}" c)
    if(NOT BT_DETAIL STREQUAL "full")
      foreach(k command stdout stderr)
        string(JSON c2 ERROR_VARIABLE je REMOVE "${c}" ${k})
        if(je STREQUAL "NOTFOUND")
          set(c "${c2}")
        endif()
      endforeach()
    endif()
    if(BT_ANONYMIZE)
      # build dir first: it is frequently nested inside the source dir
      string(REPLACE "${build_dir}" "$BUILD" c "${c}")
      if(NOT src_dir STREQUAL "")
        string(REPLACE "${src_dir}" "$SRC" c "${c}")
      endif()
    endif()
    string(APPEND buf "${sep}${c}")
    set(sep ",")
    math(EXPR chunk "${chunk} + 1")
    if(chunk GREATER_EQUAL 200)
      file(APPEND "${out_json}" "${buf}")
      set(buf "")
      set(chunk 0)
    endif()
  endforeach()
  file(APPEND "${out_json}" "${buf}]")

  set(stats "")
  foreach(role IN LISTS stats_roles)
    _bt_obj(stats ${role} "{\"count\":${st_${role}_n},\"durationMs\":${st_${role}_ms},\"failed\":${st_${role}_fail}}")
  endforeach()
  file(APPEND "${out_json}" ",\"roleStats\":{${stats}}")

  # --- CMake content files (project name, target types/labels, custom content)
  file(GLOB contents "${files_dir}/content/*.json")
  list(SORT contents)
  list(REVERSE contents)
  set(cbuf "")
  set(csep "")
  set(count 0)
  foreach(cf IN LISTS contents)
    if(count GREATER_EQUAL 3)
      break()
    endif()
    file(READ "${cf}" c)
    get_filename_component(cn "${cf}" NAME)
    string(APPEND cbuf "${csep}{\"file\":\"content/${cn}\",\"data\":${c}}")
    set(csep ",")
    math(EXPR count "${count} + 1")
  endforeach()
  file(APPEND "${out_json}" ",\"content\":[${cbuf}]}")

  # Publish the plain JSON first: should compression ever fail (it is a fatal
  # error in CMake), the uploader still finds a complete bundle to send.
  file(RENAME "${out_json}" "${out_base}.json" RESULT r)
  if(NOT r EQUAL 0)
    return()
  endif()
  file(ARCHIVE_CREATE OUTPUT "${out_base}.gz.tmp" PATHS "${out_base}.json" FORMAT raw COMPRESSION GZip)
  if(EXISTS "${out_base}.gz.tmp")
    file(SIZE "${out_base}.gz.tmp" gz_size)
    if(gz_size GREATER 0)
      file(RENAME "${out_base}.gz.tmp" "${out_base}.json.gz" RESULT r)
      if(r EQUAL 0)
        file(REMOVE "${out_base}.json")
      endif()
    else()
      file(REMOVE "${out_base}.gz.tmp")
    endif()
  endif()
endfunction()

# -----------------------------------------------------------------------------
#  Upload queue
# -----------------------------------------------------------------------------

function(_bt_upload_file file url code_out)
  set(hdr HTTPHEADER "Content-Type: application/json"
          HTTPHEADER "User-Agent: BuildTelemetry.cmake/${_BT_CLIENT_VERSION} CMake/${CMAKE_VERSION}")
  if(file MATCHES "\\.gz$")
    list(APPEND hdr HTTPHEADER "Content-Encoding: gzip")
  endif()
  if(NOT BT_TOKEN STREQUAL "")
    list(APPEND hdr HTTPHEADER "Authorization: Bearer ${BT_TOKEN}")
  endif()
  set(tls TLS_VERIFY ON)
  _bt_falsy(no_verify "${BT_TLS_VERIFY}")
  if(no_verify)
    set(tls TLS_VERIFY OFF)
  endif()
  if(NOT BT_CA_FILE STREQUAL "" AND EXISTS "${BT_CA_FILE}")
    list(APPEND tls TLS_CAINFO "${BT_CA_FILE}")
  endif()
  file(UPLOAD "${file}" "${url}" TIMEOUT ${BT_TIMEOUT} INACTIVITY_TIMEOUT 5
    STATUS st LOG lg ${tls} ${hdr})
  list(GET st 0 curl_code)
  set(http "")
  string(REGEX MATCHALL "HTTP/[0-9.]+ [0-9][0-9][0-9]" lines "${lg}")
  if(lines)
    list(GET lines -1 last)
    string(REGEX REPLACE "^HTTP/[0-9.]+ " "" http "${last}")
  endif()
  if(NOT curl_code EQUAL 0)
    list(GET st 1 msg)
    set(${code_out} "net:${curl_code}:${msg}" PARENT_SCOPE)
  else()
    set(${code_out} "${http}" PARENT_SCOPE)
  endif()
endfunction()

# Remove the oldest bundles beyond the configured cap and anything > 14 days.
function(_bt_prune_spool spool)
  file(GLOB bundles "${spool}/*.json.gz" "${spool}/*.json" "${spool}/*.partial" "${spool}/*.gz.tmp")
  list(SORT bundles)
  list(LENGTH bundles n)
  _bt_now_epoch(now)
  foreach(b IN LISTS bundles)
    file(TIMESTAMP "${b}" ts "%s" UTC)
    if(ts MATCHES "^[0-9]+$")
      math(EXPR age "${now} - ${ts}")
      if(age GREATER 1209600)
        file(REMOVE "${b}")
        math(EXPR n "${n} - 1")
        continue()
      endif()
    endif()
    if(n GREATER BT_MAX_SPOOL)
      file(REMOVE "${b}")
      math(EXPR n "${n} - 1")
    endif()
  endforeach()
  file(GLOB claims "${spool}/claims/*")
  foreach(c IN LISTS claims)
    file(TIMESTAMP "${c}" ts "%s" UTC)
    if(ts MATCHES "^[0-9]+$")
      math(EXPR age "${now} - ${ts}")
      if(age GREATER 172800)
        file(REMOVE "${c}")
      endif()
    endif()
  endforeach()
endfunction()

# Convert staged snapshots into bundles, then upload everything queued.
function(_bt_process_spool state_dir force)
  set(spool "${state_dir}/spool")
  if(NOT IS_DIRECTORY "${spool}")
    return()
  endif()
  file(LOCK "${spool}/.lock" GUARD FUNCTION TIMEOUT 0 RESULT_VARIABLE lock_rc)
  if(NOT lock_rc EQUAL 0)
    return() # another uploader is active for this build tree
  endif()
  foreach(round RANGE 2)
    # 1) staged snapshots (from the cmake --build path) -> bundles
    file(GLOB stages LIST_DIRECTORIES true "${spool}/*.staging")
    foreach(stage IN LISTS stages)
      if(NOT IS_DIRECTORY "${stage}" OR NOT EXISTS "${stage}/ready")
        continue()
      endif()
      file(STRINGS "${stage}/ready" meta)
      list(GET meta 0 bundle_id)
      list(GET meta 1 build_dir)
      list(GET meta 2 out_name)
      file(READ "${stage}/index.json" idx)
      _bt_build_bundle("${idx}" "${stage}" "${build_dir}" "${bundle_id}" "${spool}/${out_name}")
      file(REMOVE_RECURSE "${stage}")
    endforeach()

    # 2) upload queue, oldest first, honouring back-off after failures
    file(GLOB bundles "${spool}/*.json.gz" "${spool}/*.json")
    if(NOT bundles)
      break()
    endif()
    if(BT_URL STREQUAL "")
      break()
    endif()
    set(fail_count 0)
    set(next_try 0)
    if(EXISTS "${spool}/backoff")
      file(STRINGS "${spool}/backoff" bo)
      list(LENGTH bo bol)
      if(bol EQUAL 2)
        list(GET bo 0 fail_count)
        list(GET bo 1 next_try)
      endif()
    endif()
    _bt_now_epoch(now)
    if(NOT force AND next_try MATCHES "^[0-9]+$" AND now LESS next_try)
      break()
    endif()
    list(SORT bundles)
    set(uploaded 0)
    foreach(b IN LISTS bundles)
      _bt_upload_file("${b}" "${BT_URL}/api/v1/ingest" code)
      get_filename_component(bn "${b}" NAME)
      if(code MATCHES "^2[0-9][0-9]$" OR code STREQUAL "409")
        file(REMOVE "${b}")
        math(EXPR uploaded "${uploaded} + 1")
        file(REMOVE "${spool}/backoff")
        set(fail_count 0)
      elseif(code MATCHES "^(400|413|415|422)$")
        _bt_log("${state_dir}" "server rejected ${bn} (HTTP ${code}) - dropped")
        file(REMOVE "${b}")
      else()
        # network error, 401/403 (token), 429, 5xx -> keep and back off
        if(NOT fail_count MATCHES "^[0-9]+$")
          set(fail_count 0)
        endif()
        math(EXPR fail_count "${fail_count} + 1")
        if(fail_count GREATER 6)
          set(fail_count 6)
        endif()
        math(EXPR delay "60 << (${fail_count} - 1)")
        math(EXPR next "${now} + ${delay}")
        file(WRITE "${spool}/backoff" "${fail_count}\n${next}\n")
        _bt_log("${state_dir}" "upload of ${bn} failed (${code}); retry in ${delay}s")
        break()
      endif()
    endforeach()
    if(uploaded GREATER 0)
      _bt_log("${state_dir}" "uploaded ${uploaded} bundle(s) to ${BT_URL}")
    endif()
  endforeach()
  _bt_prune_spool("${spool}")
endfunction()

# Start "cmake -P <this file> worker" fully detached from the build's console/pipes.
function(_bt_spawn_worker state_dir settings_file large)
  set(self "${CMAKE_CURRENT_FUNCTION_LIST_FILE}")
  set(log "${state_dir}/worker.out")
  if(CMAKE_HOST_WIN32)
    set(done FALSE)
    if(large)
      # Start-Process (ShellExecute) does not inherit handles, so IDEs / pipes that
      # capture `cmake --build` output are released immediately (~0.5 s to start).
      file(TO_NATIVE_PATH "${CMAKE_COMMAND}" exe)
      string(REPLACE "'" "''" exe "${exe}")
      string(REPLACE "'" "''" s "${settings_file}")
      string(REPLACE "'" "''" d "${state_dir}")
      string(REPLACE "'" "''" m "${self}")
      execute_process(COMMAND powershell -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command
        "Start-Process -WindowStyle Hidden -FilePath '${exe}' -ArgumentList '-DBT_MODE=worker','\"-DBT_STATE_DIR=${d}\"','\"-DBT_SETTINGS=${s}\"','-P','\"${m}\"'"
        OUTPUT_QUIET ERROR_QUIET RESULT_VARIABLE rc TIMEOUT 15)
      if(rc EQUAL 0)
        set(done TRUE)
      endif()
    endif()
    if(NOT done)
      execute_process(COMMAND cmd /c start "" /b "${CMAKE_COMMAND}" -DBT_MODE=worker
        "-DBT_STATE_DIR=${state_dir}" "-DBT_SETTINGS=${settings_file}" -P "${self}"
        OUTPUT_FILE "${log}" ERROR_FILE "${log}" RESULT_VARIABLE rc TIMEOUT 15)
    endif()
  else()
    # sh -c '<script>' sh <log> <cmd...>: the worker gets its own session and no
    # inherited stdio, so neither the terminal nor a capturing pipe waits for it.
    execute_process(COMMAND sh -c
      "log=\"$1\"; shift; if command -v setsid >/dev/null 2>&1; then setsid \"$@\" </dev/null >>\"$log\" 2>&1 & else nohup \"$@\" </dev/null >>\"$log\" 2>&1 & fi"
      sh "${log}" "${CMAKE_COMMAND}" -DBT_MODE=worker "-DBT_STATE_DIR=${state_dir}" "-DBT_SETTINGS=${settings_file}" -P "${self}"
      OUTPUT_QUIET ERROR_QUIET RESULT_VARIABLE rc TIMEOUT 15)
  endif()
endfunction()

# -----------------------------------------------------------------------------
#  Script entry points (cmake -P)
# -----------------------------------------------------------------------------

# Called by CMake after indexing: last argument is the index file.
function(_bt_callback index_file)
  _bt_env_disabled(bt_disabled)
  if(bt_disabled OR NOT EXISTS "${index_file}")
    return()
  endif()
  _bt_load_runtime_settings("${BT_SETTINGS}")
  file(READ "${index_file}" idx)
  string(JSON build_dir ERROR_VARIABLE e1 GET "${idx}" buildDir)
  string(JSON data_dir ERROR_VARIABLE e2 GET "${idx}" dataDir)
  string(JSON hook ERROR_VARIABLE e3 GET "${idx}" hook)
  if(NOT e1 STREQUAL "NOTFOUND" OR NOT e2 STREQUAL "NOTFOUND" OR NOT IS_DIRECTORY "${data_dir}")
    return()
  endif()
  _bt_index_snippets(names "${idx}")
  # Skip no-op builds ("ninja: no work to do"): only the build tool's own snippet.
  set(meaningful FALSE)
  foreach(name IN LISTS names)
    if(NOT name MATCHES "^(build|cmakeBuild)-")
      set(meaningful TRUE)
      break()
    endif()
  endforeach()
  if(NOT meaningful)
    return()
  endif()
  set(state_dir "${build_dir}/.cmake/build-telemetry")
  set(spool "${state_dir}/spool")
  file(MAKE_DIRECTORY "${spool}/claims" RESULT r)
  if(NOT r EQUAL 0)
    return()
  endif()

  # Several queries (project + machine mode) may register us: handle each index once.
  _bt_bundle_id(bundle_id "${build_dir}" "${index_file}")
  if(EXISTS "${spool}/claims/${bundle_id}")
    return()
  endif()
  file(TOUCH "${spool}/claims/${bundle_id}")

  string(TIMESTAMP stamp "%Y%m%dT%H%M%S" UTC)
  set(out_name "${stamp}-${bundle_id}")

  _bt_detect_ci()
  string(TOLOWER "${BT_UPLOAD}" upload_mode)
  set(inline FALSE)
  if(hook STREQUAL "postBuild" OR hook STREQUAL "manual")
    set(inline TRUE)   # already running in CMake's background daemon / explicit
  elseif(upload_mode STREQUAL "sync")
    set(inline TRUE)
  elseif(upload_mode STREQUAL "auto" AND NOT ci_provider STREQUAL "")
    set(inline TRUE)   # CI: finish before the job ends; nobody is waiting interactively
  endif()

  if(inline)
    _bt_build_bundle("${idx}" "${data_dir}" "${build_dir}" "${bundle_id}" "${spool}/${out_name}")
    _bt_process_spool("${state_dir}" FALSE)
    return()
  endif()

  # Interactive `cmake --build`: snapshot via hard links (CMake deletes the
  # snippets as soon as callbacks return) and let a detached worker do the rest.
  set(stage "${spool}/${bundle_id}.staging")
  file(MAKE_DIRECTORY "${stage}/content" RESULT r)
  if(NOT r EQUAL 0)
    return()
  endif()
  list(LENGTH names n)
  foreach(name IN LISTS names)
    file(CREATE_LINK "${data_dir}/${name}" "${stage}/${name}" RESULT lr COPY_ON_ERROR)
  endforeach()
  file(GLOB contents "${data_dir}/content/*.json")
  foreach(cf IN LISTS contents)
    get_filename_component(cn "${cf}" NAME)
    file(CREATE_LINK "${cf}" "${stage}/content/${cn}" RESULT lr COPY_ON_ERROR)
  endforeach()
  file(WRITE "${stage}/index.json" "${idx}")
  file(WRITE "${stage}/ready" "${bundle_id}\n${build_dir}\n${out_name}\n")
  set(large FALSE)
  if(n GREATER 150)
    set(large TRUE)
  endif()
  _bt_spawn_worker("${state_dir}" "${BT_SETTINGS}" ${large})
endfunction()

function(_bt_query_json out cmake_exe self settings_file data_minor with_process_metrics with_dynamic hooks_and_callback)
  set(options "\"staticSystemInformation\"")
  if(with_process_metrics)
    string(APPEND options ",\"processMetrics\"")
  endif()
  if(with_dynamic)
    string(APPEND options ",\"dynamicSystemInformation\"")
  endif()
  # CMake 4.3.0 accepts only an integer version (the {major, minor} object came in a
  # later 4.3 patch). CMake always writes its newest data version anyway, so the object
  # is needed only for options that a minor version introduced (processMetrics: 1.2).
  if(data_minor EQUAL 0)
    set(version "1")
  else()
    set(version "{\"major\":1,\"minor\":${data_minor}}")
  endif()
  if(hooks_and_callback)
    set(cb "\"${cmake_exe}\" -DBT_MODE=callback \"-DBT_SETTINGS=${settings_file}\" -P \"${self}\"")
    _bt_json_str(cbq "${cb}")
    set(body "\"version\":${version},\"hooks\":[\"postBuild\",\"postCMakeBuild\"],\"options\":[${options}],\"callbacks\":[${cbq}]")
  else()
    set(body "\"version\":${version},\"options\":[${options}]")
  endif()
  set(${out} "{${body}}\n" PARENT_SCOPE)
endfunction()

function(_bt_write_settings file mode url token detail tags)
  set(t "# BuildTelemetry settings (generated) - key=value, environment variables override\n")
  string(APPEND t "mode=${mode}\n")
  string(APPEND t "url=${url}\n")
  if(NOT token STREQUAL "")
    string(APPEND t "token=${token}\n")
  endif()
  string(APPEND t "detail=${detail}\n")
  if(NOT tags STREQUAL "")
    string(APPEND t "tags=${tags}\n")
  endif()
  foreach(k upload timeout tls_verify ca_file user_id anonymize max_spool)
    string(TOUPPER "BUILD_TELEMETRY_${k}" var)
    if(DEFINED ${var} AND NOT "${${var}}" STREQUAL "")
      string(APPEND t "${k}=${${var}}\n")
    endif()
  endforeach()
  file(WRITE "${file}" "${t}")
endfunction()

function(_bt_cmd_install)
  if(CMAKE_VERSION VERSION_LESS 4.3)
    message(WARNING "BuildTelemetry: this CMake (${CMAKE_VERSION}) cannot produce instrumentation data itself; "
      "builds driven by CMake >= 4.3 will still be instrumented, using this executable for the callback.")
  endif()
  _bt_user_config_dir(cfg)
  _bt_load_runtime_settings("${cfg}/build-telemetry/settings.txt")
  if(DEFINED BUILD_TELEMETRY_URL)
    set(BT_URL "${BUILD_TELEMETRY_URL}")
  endif()
  if(DEFINED BUILD_TELEMETRY_TOKEN)
    set(BT_TOKEN "${BUILD_TELEMETRY_TOKEN}")
  endif()
  if(DEFINED BUILD_TELEMETRY_DETAIL)
    set(BT_DETAIL "${BUILD_TELEMETRY_DETAIL}")
  endif()
  if(DEFINED BUILD_TELEMETRY_TAGS)
    set(BT_TAGS "${BUILD_TELEMETRY_TAGS}")
  endif()
  if(BT_URL STREQUAL "")
    message(FATAL_ERROR "BuildTelemetry: pass the server URL: cmake -DBUILD_TELEMETRY_URL=https://host -P BuildTelemetry.cmake install")
  endif()
  set(home "${cfg}/build-telemetry")
  file(MAKE_DIRECTORY "${home}" "${cfg}/instrumentation/v1/query")
  file(COPY_FILE "${CMAKE_CURRENT_FUNCTION_LIST_FILE}" "${home}/BuildTelemetry.cmake" ONLY_IF_DIFFERENT)
  _bt_write_settings("${home}/settings.txt" machine "${BT_URL}" "${BT_TOKEN}" "${BT_DETAIL}" "${BT_TAGS}")
  _bt_truthy(dyn "${BUILD_TELEMETRY_DYNAMIC_SYSINFO}")
  # Every CMake >= 4.3 of this user reads this query, so it must be valid for all of
  # them: plain version 1, no processMetrics (CMake 4.3.0 rejects a 1.2 query outright).
  _bt_query_json(q "${CMAKE_COMMAND}" "${home}/BuildTelemetry.cmake" "${home}/settings.txt" 0 FALSE ${dyn} TRUE)
  file(WRITE "${cfg}/instrumentation/v1/query/build-telemetry.json" "${q}")
  file(REMOVE "${cfg}/instrumentation/v1/query/build-telemetry-metrics.json")  # written by client 1.0.0
  message(STATUS "BuildTelemetry ${_BT_CLIENT_VERSION} installed for this user")
  message(STATUS "  endpoint : ${BT_URL}")
  message(STATUS "  detail   : ${BT_DETAIL}")
  message(STATUS "  query    : ${cfg}/instrumentation/v1/query/build-telemetry.json")
  message(STATUS "  settings : ${home}/settings.txt")
  message(STATUS "Every CMake >= 4.3 build (Ninja/Makefiles) of this user is now instrumented.")
  message(STATUS "Disable temporarily with BUILD_TELEMETRY=OFF, remove with: cmake -P BuildTelemetry.cmake uninstall")
endfunction()

function(_bt_cmd_uninstall)
  _bt_user_config_dir(cfg)
  file(REMOVE "${cfg}/instrumentation/v1/query/build-telemetry.json"
              "${cfg}/instrumentation/v1/query/build-telemetry-metrics.json"
              "${cfg}/build-telemetry/settings.txt"
              "${cfg}/build-telemetry/BuildTelemetry.cmake")
  message(STATUS "BuildTelemetry machine-wide instrumentation removed (machine-id kept).")
endfunction()

function(_bt_cmd_status)
  _bt_user_config_dir(cfg)
  set(q "${cfg}/instrumentation/v1/query/build-telemetry.json")
  _bt_load_runtime_settings("${cfg}/build-telemetry/settings.txt")
  _bt_env_disabled(bt_disabled)
  _bt_machine_id(mid)
  message(STATUS "BuildTelemetry ${_BT_CLIENT_VERSION} (CMake ${CMAKE_VERSION})")
  if(EXISTS "${q}")
    message(STATUS "  machine mode : installed (${q})")
  else()
    message(STATUS "  machine mode : not installed")
  endif()
  message(STATUS "  endpoint     : ${BT_URL}")
  message(STATUS "  detail       : ${BT_DETAIL}")
  message(STATUS "  machine id   : ${mid}")
  if(bt_disabled)
    message(STATUS "  environment  : telemetry DISABLED (BUILD_TELEMETRY / DO_NOT_TRACK)")
  endif()
endfunction()

function(_bt_cmd_test)
  _bt_user_config_dir(cfg)
  _bt_load_runtime_settings("${cfg}/build-telemetry/settings.txt")
  if(DEFINED BUILD_TELEMETRY_URL)
    set(BT_URL "${BUILD_TELEMETRY_URL}")
  endif()
  if(DEFINED BUILD_TELEMETRY_TOKEN)
    set(BT_TOKEN "${BUILD_TELEMETRY_TOKEN}")
  endif()
  if(BT_URL STREQUAL "")
    message(FATAL_ERROR "BuildTelemetry: no endpoint configured")
  endif()
  set(hdr "")
  if(NOT BT_TOKEN STREQUAL "")
    set(hdr HTTPHEADER "Authorization: Bearer ${BT_TOKEN}")
  endif()
  file(MAKE_DIRECTORY "${cfg}/build-telemetry")
  set(tmp "${cfg}/build-telemetry/.ping.json")
  file(DOWNLOAD "${BT_URL}/api/v1/ingest/ping" "${tmp}" TIMEOUT ${BT_TIMEOUT} STATUS st LOG lg ${hdr})
  list(GET st 0 code)
  string(REGEX MATCHALL "HTTP/[0-9.]+ [0-9][0-9][0-9]" lines "${lg}")
  set(http "")
  if(lines)
    list(GET lines -1 http)
  endif()
  set(body "")
  if(EXISTS "${tmp}")
    file(READ "${tmp}" body)
    file(REMOVE "${tmp}")
  endif()
  if(code EQUAL 0 AND http MATCHES " 200$")
    message(STATUS "BuildTelemetry: ${BT_URL} reachable and token accepted: ${body}")
  else()
    list(GET st 1 msg)
    message(WARNING "BuildTelemetry: ping failed (${msg} ${http}) ${body}")
  endif()
endfunction()

function(_bt_cmd_flush build_dir)
  get_filename_component(build_dir "${build_dir}" ABSOLUTE)
  set(state_dir "${build_dir}/.cmake/build-telemetry")
  set(settings "${state_dir}/settings.txt")
  if(NOT EXISTS "${settings}")
    _bt_user_config_dir(cfg)
    set(settings "${cfg}/build-telemetry/settings.txt")
  endif()
  _bt_load_runtime_settings("${settings}")
  file(GLOB before "${state_dir}/spool/*.json.gz" "${state_dir}/spool/*.json" "${state_dir}/spool/*.staging")
  list(LENGTH before nb)
  _bt_process_spool("${state_dir}" TRUE)
  file(GLOB after "${state_dir}/spool/*.json.gz" "${state_dir}/spool/*.json" "${state_dir}/spool/*.staging")
  list(LENGTH after na)
  message(STATUS "BuildTelemetry: flushed ${build_dir}: ${nb} pending before, ${na} after")
endfunction()

function(_bt_script_main)
  # Positional arguments after "-P <file>"
  set(args "")
  set(script_idx -1)
  math(EXPR last "${CMAKE_ARGC} - 1")
  foreach(i RANGE 1 ${last})
    if(script_idx EQUAL -1)
      if(CMAKE_ARGV${i} STREQUAL "-P")
        math(EXPR script_idx "${i} + 1")
      endif()
    elseif(i GREATER script_idx)
      list(APPEND args "${CMAKE_ARGV${i}}")
    endif()
  endforeach()
  set(mode "${BT_MODE}")
  if(mode STREQUAL "" AND args)
    list(GET args 0 mode)
    list(REMOVE_AT args 0)
  endif()
  if(mode STREQUAL "callback")
    if(args)
      list(GET args -1 index_file)
      _bt_callback("${index_file}")
    endif()
  elseif(mode STREQUAL "worker")
    _bt_env_disabled(bt_disabled)
    if(NOT bt_disabled)
      _bt_load_runtime_settings("${BT_SETTINGS}")
      _bt_process_spool("${BT_STATE_DIR}" FALSE)
    endif()
  elseif(mode STREQUAL "install")
    _bt_cmd_install()
  elseif(mode STREQUAL "uninstall")
    _bt_cmd_uninstall()
  elseif(mode STREQUAL "status")
    _bt_cmd_status()
  elseif(mode STREQUAL "test")
    _bt_cmd_test()
  elseif(mode STREQUAL "flush")
    if(NOT args)
      message(FATAL_ERROR "usage: cmake -P BuildTelemetry.cmake flush <build-dir>")
    endif()
    list(GET args 0 bd)
    _bt_cmd_flush("${bd}")
  else()
    message("usage: cmake [-DBUILD_TELEMETRY_URL=<url>] [-DBUILD_TELEMETRY_TOKEN=<token>] -P BuildTelemetry.cmake <install|uninstall|status|test|flush <build-dir>>")
  endif()
endfunction()

# -----------------------------------------------------------------------------
#  Project mode (include())
# -----------------------------------------------------------------------------

function(_bt_project_main)
  get_property(done GLOBAL PROPERTY _BUILD_TELEMETRY_CONFIGURED)
  if(done)
    return()
  endif()
  set_property(GLOBAL PROPERTY _BUILD_TELEMETRY_CONFIGURED 1)

  option(BUILD_TELEMETRY "Collect build telemetry via CMake instrumentation and upload it" ON)
  set(BUILD_TELEMETRY_URL "" CACHE STRING "BuildTelemetry server URL (empty: env BUILD_TELEMETRY_URL / user settings)")
  set(BUILD_TELEMETRY_DETAIL "full" CACHE STRING "Telemetry detail: full | nocommands | summary")
  set_property(CACHE BUILD_TELEMETRY_DETAIL PROPERTY STRINGS full nocommands summary)
  mark_as_advanced(BUILD_TELEMETRY_DETAIL)

  set(state_dir "${CMAKE_BINARY_DIR}/.cmake/build-telemetry")
  set(query_dir "${CMAKE_BINARY_DIR}/.cmake/instrumentation/v1/query")
  set(query_file "${query_dir}/build-telemetry.json")
  _bt_truthy(quiet "${BUILD_TELEMETRY_QUIET}")

  set(reason "")
  _bt_env_disabled(env_off)
  if(NOT BUILD_TELEMETRY)
    set(reason "disabled (BUILD_TELEMETRY=OFF)")
  elseif(env_off)
    set(reason "disabled by environment (BUILD_TELEMETRY / DO_NOT_TRACK)")
  elseif(CMAKE_VERSION VERSION_LESS 4.3)
    set(reason "CMake ${CMAKE_VERSION} has no build instrumentation (needs >= 4.3) - off")
  elseif(NOT CMAKE_GENERATOR MATCHES "Ninja|Makefiles|FASTBuild")
    set(reason "generator '${CMAKE_GENERATOR}' is not instrumented by CMake (use Ninja or Makefiles) - off")
  endif()

  # Endpoint: CMake variable > environment > user settings > vendored default
  set(url "")
  if(reason STREQUAL "")
    _bt_user_config_dir(cfg)
    set(_bts_url "")
    set(_bts_token "")
    _bt_read_settings("${cfg}/build-telemetry/settings.txt" _bts)
    if(DEFINED BUILD_TELEMETRY_URL AND NOT BUILD_TELEMETRY_URL STREQUAL "")
      set(url "${BUILD_TELEMETRY_URL}")
    elseif(NOT "$ENV{BUILD_TELEMETRY_URL}" STREQUAL "")
      set(url "$ENV{BUILD_TELEMETRY_URL}")
    elseif(NOT _bts_url STREQUAL "")
      set(url "${_bts_url}")
    else()
      set(url "${_BT_DEFAULT_URL}")
    endif()
    if(url STREQUAL "")
      set(reason "no endpoint configured (set BUILD_TELEMETRY_URL) - off")
    endif()
  endif()

  if(NOT reason STREQUAL "")
    if(EXISTS "${query_file}")
      file(REMOVE "${query_file}")
    endif()
    if(NOT quiet)
      message(STATUS "BuildTelemetry: ${reason}")
    endif()
    return()
  endif()

  set(token "")
  if(DEFINED BUILD_TELEMETRY_TOKEN)
    set(token "${BUILD_TELEMETRY_TOKEN}")
  elseif(NOT _bts_token STREQUAL "")
    set(token "${_bts_token}")
  endif()
  set(detail "${BUILD_TELEMETRY_DETAIL}")
  if(NOT "$ENV{BUILD_TELEMETRY_DETAIL}" STREQUAL "")
    set(detail "$ENV{BUILD_TELEMETRY_DETAIL}")
  endif()

  file(MAKE_DIRECTORY "${state_dir}" "${query_dir}")
  configure_file("${CMAKE_CURRENT_FUNCTION_LIST_FILE}" "${state_dir}/BuildTelemetry.cmake" COPYONLY)
  _bt_write_settings("${state_dir}/settings.txt" project "${url}" "${token}" "${detail}" "${BUILD_TELEMETRY_TAGS}")

  # The configuring CMake reads this query itself, so 4.5+ may ask for data 1.2 (processMetrics).
  if(CMAKE_VERSION VERSION_GREATER_EQUAL 4.5)
    set(minor 2)
    set(pm TRUE)
  else()
    set(minor 0)
    set(pm FALSE)
  endif()
  _bt_truthy(dyn "${BUILD_TELEMETRY_DYNAMIC_SYSINFO}")
  _bt_query_json(q "${CMAKE_COMMAND}" "${state_dir}/BuildTelemetry.cmake" "${state_dir}/settings.txt" ${minor} ${pm} ${dyn} TRUE)
  set(old "")
  if(EXISTS "${query_file}")
    file(READ "${query_file}" old)
  endif()
  if(NOT old STREQUAL q)
    file(WRITE "${query_file}" "${q}")
  endif()
  if(NOT quiet)
    message(STATUS "BuildTelemetry: enabled -> ${url} (detail=${detail}; disable with -DBUILD_TELEMETRY=OFF or env BUILD_TELEMETRY=OFF)")
  endif()
endfunction()

cmake_policy(POP)

if(CMAKE_SCRIPT_MODE_FILE AND CMAKE_SCRIPT_MODE_FILE STREQUAL CMAKE_CURRENT_LIST_FILE)
  _bt_script_main()
else()
  _bt_project_main()
endif()
